const SPREADSHEET_ID = '';

// ============================================================
// FACTEURS CO2 — ADEME / Base Empreinte / ARCEP
// ============================================================
const CO2_FACTEURS = {
  // DCD Données
  goCloud:       209.5,  // g CO₂/Go/an — The Shift Project / GreenIT.fr
  goLocal:       3.2,    // g CO₂/Go/an — ADEME / NégaOctet
  email:         0.3,  // g CO₂/email supprimé — stockage évité
                         // Calcul : 75 Ko × 209,5 g/Go/an ÷ 1 048 576
                         // Source : ARCEP 2023 / ADEME Base Empreinte®
  fichierCloud:  8.0,    // g CO₂/fichier cloud — NégaOctet estimé
  fichierLocal:  2.0,    // g CO₂/fichier local — ADEME estimé
  app:           1.46,   // g CO₂/app/an — GreenIT.fr
  postSocial:    0.5,    // g CO₂/post supprimé — estimation

  // DCD Réemploi — économie fabrication sur 2 ans (g CO₂/équipement)
  smartphone:    30000,  // 30 kg CO₂ — ADEME Base Empreinte®
  portable:      156000, // 156 kg CO₂ — ADEME Base Empreinte®
  fixe:          175000, // 175 kg CO₂ — ADEME Base Empreinte®
  ecran:         80000,  // 80 kg CO₂ — ADEME Base Empreinte®
  tablette:      63000,  // 63 kg CO₂ — ADEME Base Empreinte®

  // DCD Recyclage — CO₂ évité par kg de DEEE recyclé
  deeeRecycle:   2500    // g CO₂/kg DEEE recyclé — ADEME estimé
};

// ============================================================
// CALCUL CO2 CENTRALISÉ
// ============================================================

function calculerCO2(totaux) {

  // Sécurisation des valeurs nulles
  const t = {
    goCloud:       Number(totaux.goCloud)       || 0,
    goLocal:       Number(totaux.goLocal)       || 0,
    emails:        Number(totaux.emails)        || 0,
    fichiersCloud: Number(totaux.fichiersCloud) || 0,
    fichiersLocal: Number(totaux.fichiersLocal) || 0,
    apps:          Number(totaux.apps)          || 0,
    posts:         Number(totaux.posts)         || 0,
    smartphones:   Number(totaux.smartphones)   || 0,
    portables:     Number(totaux.portables)     || 0,
    fixes:         Number(totaux.fixes)         || 0,
    ecrans:        Number(totaux.ecrans)        || 0,
    tablettes:     Number(totaux.tablettes)     || 0,
    poidsDeee:     Number(totaux.poidsDeee)     || 0
  };

  // ===== DCD DONNÉES =====
  const co2GoCloud       = t.goCloud       * CO2_FACTEURS.goCloud;
  const co2GoLocal       = t.goLocal       * CO2_FACTEURS.goLocal;
  const co2Emails        = t.emails        * CO2_FACTEURS.email;
  const co2FichiersCloud = t.fichiersCloud * CO2_FACTEURS.fichierCloud;
  const co2FichiersLocal = t.fichiersLocal * CO2_FACTEURS.fichierLocal;
  const co2Apps          = t.apps          * CO2_FACTEURS.app;
  const co2Posts         = t.posts         * CO2_FACTEURS.postSocial;

  const co2TotalDonnees = co2GoCloud + co2GoLocal + co2Emails
                        + co2FichiersCloud + co2FichiersLocal
                        + co2Apps + co2Posts;

  // ===== DCD RÉEMPLOI =====
  const co2Smartphones  = t.smartphones * CO2_FACTEURS.smartphone;
  const co2Portables    = t.portables   * CO2_FACTEURS.portable;
  const co2Fixes        = t.fixes       * CO2_FACTEURS.fixe;
  const co2Ecrans       = t.ecrans      * CO2_FACTEURS.ecran;
  const co2Tablettes    = t.tablettes   * CO2_FACTEURS.tablette;

  const co2TotalReemploi = co2Smartphones + co2Portables + co2Fixes
                         + co2Ecrans + co2Tablettes;

  // ===== DCD RECYCLAGE =====
  const poidsRecycle      = t.poidsDeee * 0.76;
  const co2TotalRecyclage = poidsRecycle * CO2_FACTEURS.deeeRecycle;

  // ===== TOTAL GLOBAL =====
  const co2TotalGrammes = co2TotalDonnees + co2TotalReemploi + co2TotalRecyclage;
  const co2KgEvite      = co2TotalGrammes / 1000;
  const co2TEvite       = co2KgEvite / 1000;

  // ===== DÉTAIL EN KG =====
  const co2Detail = {
    goCloud:        co2GoCloud        / 1000,
    goLocal:        co2GoLocal        / 1000,
    emails:         co2Emails         / 1000,
    posts:          co2Posts          / 1000,
    fichiersCloud:  co2FichiersCloud  / 1000,
    fichiersLocal:  co2FichiersLocal  / 1000,
    apps:           co2Apps           / 1000,
    totalDonnees:   co2TotalDonnees   / 1000,
    smartphones:    co2Smartphones    / 1000,
    portables:      co2Portables      / 1000,
    fixes:          co2Fixes          / 1000,
    ecrans:         co2Ecrans         / 1000,
    tablettes:      co2Tablettes      / 1000,
    totalReemploi:  co2TotalReemploi  / 1000,
    poidsRecycle:   poidsRecycle,
    totalRecyclage: co2TotalRecyclage / 1000
  };

  // ===== ÉQUIVALENCES =====
  const equivalences = {
    kmVoiture:         Math.round(co2KgEvite / 0.218),
    ARParisNYC:        (co2KgEvite / 1752).toFixed(2),
    trajetsVoiture:    Math.round(co2KgEvite / 218),
    trajetsTGV:        Math.round(co2KgEvite / 2.34),
    heuresStreaming:   Math.round(co2KgEvite / 0.036),
    empreinteFrancais: (co2TEvite / 9.9).toFixed(3)
  };

  // ===== RÉPARTITION EN % =====
  const repartition = {
    donneesPct:   co2TotalGrammes > 0
      ? ((co2TotalDonnees   / co2TotalGrammes) * 100).toFixed(1) : '0.0',
    reemploiPct:  co2TotalGrammes > 0
      ? ((co2TotalReemploi  / co2TotalGrammes) * 100).toFixed(1) : '0.0',
    recyclagePct: co2TotalGrammes > 0
      ? ((co2TotalRecyclage / co2TotalGrammes) * 100).toFixed(1) : '0.0'
  };

  return { co2KgEvite, co2TEvite, co2Detail, equivalences, repartition };
}

