/**
 * Nettoie une chaîne : longueur max, et préfixe les formules Sheets potentielles.
 */
function sanitizeStr(val, maxLen) {
  var s = String(val || '').trim().slice(0, maxLen || 200);
  // Protège contre l'injection de formules dans Google Sheets
  if (/^[=+\-@]/.test(s)) s = "'" + s;
  return s;
}

function doPost(e) {
  try {
    let data;
    if (e.postData && e.postData.contents) {
      data = JSON.parse(e.postData.contents);
    } else if (e.parameter && e.parameter.data) {
      data = JSON.parse(e.parameter.data);
    } else {
      throw new Error('Aucune donnée reçue');
    }

    // Validation de structure minimale
    if (!data || typeof data !== 'object' || !data.metadata || typeof data.metadata !== 'object') {
      throw new Error('Payload invalide');
    }
    if (!Array.isArray(data.metadata.actionsRealisees)) {
      throw new Error('actionsRealisees doit être un tableau');
    }

    console.log('Données reçues metadata:', JSON.stringify(data.metadata));

    const ss          = SpreadsheetApp.openById(SPREADSHEET_ID);
    const date        = data.metadata.dateSubmission || new Date().toISOString();
    const eventDate   = sanitizeStr(data.metadata.eventDate,  20);
    const cleanupId   = sanitizeStr(data.metadata.cleanupId,  50);
    const organizer   = sanitizeStr(data.metadata.organizer, 200);
    const structure   = sanitizeStr(data.metadata.structureType, 100);
    const region      = sanitizeStr(data.metadata.region,    100);
    const departement = sanitizeStr(data.metadata.departement, 100);
    const actions     = data.metadata.actionsRealisees.map(function(a){ return sanitizeStr(a, 50); }).join(', ');
    const personneattainte = Math.max(0, parseInt(data.metadata.personneattainte, 10) || 0);

    writeGeneral(ss, date, eventDate, cleanupId, organizer,
                 structure, region, departement, personneattainte, actions);

    if (data.sensibilisation) writeSensibilisation(ss, date, cleanupId, organizer, region, departement, data.sensibilisation);
    if (data.reemploi)        writeReemploi(ss, date, cleanupId, organizer, region, departement, data.reemploi);
    if (data.donnees)         writeDonnees(ss, date, cleanupId, organizer, region, departement, data.donnees);
    if (data.recyclage)       writeRecyclage(ss, date, cleanupId, organizer, region, departement, data.recyclage);

    return buildResponse(true, 'Données enregistrées avec succès !');

  } catch (error) {
    console.error('Erreur doPost:', error);
    return buildResponse(false, 'Erreur : ' + error.message);
  }
}

// ============================================================
// ÉCRITURE ONGLETS
// ============================================================

function writeGeneral(ss, date, eventDate, cleanupId, organizer, structure, region, departement, personneattainte, actions) {
  const sheet = ss.getSheetByName('Général');
  if (!sheet) throw new Error('Onglet "Général" introuvable');

  const headers = sheet.getRange(1, 1, 1, 10).getValues()[0];
  if (!headers[0] || headers[0] === '') {
    sheet.getRange(1, 1, 1, 10).setValues([[
      'Date soumission', 'Date événement', 'Cleanup ID', 'Organisateur',
      'Type de structure', 'Région', 'Département',
      'Personnes atteintes', 'Actions réalisées', 'Nb actions'
    ]]);
  }

  sheet.appendRow([
    formatDate(date), eventDate, cleanupId, organizer,
    structure, region, departement, personneattainte,
    actions, actions.split(',').length
  ]);
}

function writeSensibilisation(ss, date, cleanupId, organizer, region, departement, data) {
  const sheet = ss.getSheetByName('Sensibilisation');
  if (!sheet) throw new Error('Onglet "Sensibilisation" introuvable');

  const types = [
    { key: 'webinaire',        label: 'Webinaire de sensibilisation' },
    { key: 'fresqueNumerique', label: 'Fresque du numérique' },
    { key: 'jeuxNumeville',    label: 'Jeux Numéville' },
    { key: 'jeuxDowino',       label: 'Jeux Dowino' },
    { key: 'jeuxTheWokies',    label: 'Jeux The Wokies' },
    { key: 'autreFormat',      label: null }
  ];

  types.forEach(type => {
    const entry = data[type.key];
    if (!entry || (entry.participants === 0 && entry.audience === 0)) return;
    const typeLabel = type.key === 'autreFormat'
      ? ('Autre : ' + (entry.label || 'Non précisé'))
      : type.label;
    sheet.appendRow([
      formatDate(date), cleanupId, organizer, region, departement,
      typeLabel, entry.participants || 0, entry.audience || 0
    ]);
  });
}

function writeReemploi(ss, date, cleanupId, organizer, region, departement, data) {
  const sheet = ss.getSheetByName('Réemploi');
  if (!sheet) throw new Error('Onglet "Réemploi" introuvable');

  const equipements = [
    { key: 'ordinateurFixe',     label: 'Ordinateur fixe' },
    { key: 'ecran',              label: 'Écran' },
    { key: 'ordinateurPortable', label: 'Ordinateur portable' },
    { key: 'tablette',           label: 'Tablette' },
    { key: 'smartphone',         label: 'Smartphone' }
  ];

  equipements.forEach(eq => {
    const entry = data[eq.key];
    if (!entry) return;
    const total = (entry.don||0) + (entry.reparation||0)
                + (entry.protection||0) + (entry.reutilisation||0);
    if (total === 0) return;
    sheet.appendRow([
      formatDate(date), cleanupId, organizer, region, departement, eq.label,
      entry.don||0, entry.reparation||0, entry.protection||0, entry.reutilisation||0
    ]);
  });
}

function writeDonnees(ss, date, cleanupId, organizer, region, departement, data) {
  const sheet = ss.getSheetByName('Données');
  if (!sheet) throw new Error('Onglet "Données" introuvable');

  sheet.appendRow([
    formatDate(date), cleanupId, organizer, region, departement,
    data.fichiersSupprimes?.emails       || 0,  // col[5]
    data.fichiersSupprimes?.postsSociaux || 0,  // col[6]
    data.fichiersSupprimes?.cloud        || 0,  // col[7]
    data.fichiersSupprimes?.local        || 0,  // col[8]
    data.applicationsDesinstallees       || 0,  // col[9]
    data.goRecuperes?.cloud              || 0,  // col[10]
    data.goRecuperes?.local              || 0   // col[11]
  ]);
}

function writeRecyclage(ss, date, cleanupId, organizer, region, departement, data) {
  const sheet = ss.getSheetByName('Recyclage');
  if (!sheet) throw new Error('Onglet "Recyclage" introuvable');

  const equipements = [
    { key: 'ordinateurFixe',     label: 'Ordinateur fixe' },
    { key: 'ecran',              label: 'Écran' },
    { key: 'ordinateurPortable', label: 'Ordinateur portable' },
    { key: 'tablette',           label: 'Tablette' },
    { key: 'smartphone',         label: 'Smartphone' },
    { key: 'divers',             label: 'Divers' }
  ];

  equipements.forEach(eq => {
    const entry = data[eq.key];
    if (!entry || ((entry.quantite||0) === 0 && (entry.poidsKg||0) === 0)) return;
    sheet.appendRow([
      formatDate(date), cleanupId, organizer, region, departement,
      eq.label, entry.quantite||0, entry.poidsKg||0
    ]);
  });
}

// ============================================================
// LECTURE DES DONNÉES BRUTES
// ============================================================

function lireDonneesBrutes(ss, filterRegion, filterStructure) {
  const genData  = ss.getSheetByName('Général').getDataRange().getValues();
  const sensData = ss.getSheetByName('Sensibilisation').getDataRange().getValues();
  const reData   = ss.getSheetByName('Réemploi').getDataRange().getValues();
  const donData  = ss.getSheetByName('Données').getDataRange().getValues();
  const recData  = ss.getSheetByName('Recyclage').getDataRange().getValues();

  // Filtrage
  const filteredIds = new Set();
  const useFilter   = filterRegion || filterStructure;

  for (let i = 1; i < genData.length; i++) {
    const structure = String(genData[i][4] || '');
    const region    = String(genData[i][5] || '');
    if (filterRegion    && region    !== filterRegion)    continue;
    if (filterStructure && structure !== filterStructure) continue;
    filteredIds.add(String(genData[i][2]));
  }

  function matchesFilter(row, idCol) {
    if (!useFilter) return true;
    return filteredIds.has(String(row[idCol]));
  }

  // ===== GÉNÉRAL =====
  let totalDCD = 0;
  const typologies = {}, regions = {};
  for (let i = 1; i < genData.length; i++) {
    if (useFilter && !filteredIds.has(String(genData[i][2]))) continue;
    totalDCD++;
    const t = String(genData[i][4] || 'Non renseigné');
    const r = String(genData[i][5] || 'Non renseignée');
    typologies[t] = (typologies[t] || 0) + 1;
    regions[r]    = (regions[r]    || 0) + 1;
  }

  // ===== SENSIBILISATION =====
  let totalParticipants = 0, totalAudience = 0;
  for (let i = 1; i < sensData.length; i++) {
    if (!matchesFilter(sensData[i], 1)) continue;
    totalParticipants += Number(sensData[i][6]) || 0;
    totalAudience     += Number(sensData[i][7]) || 0;
  }

  // ===== DONNÉES =====
  // Colonnes : [0]Date [1]ID [2]Organisateur [3]Région [4]Département
  //            [5]Emails [6]Posts [7]FichiersCloud [8]FichiersLocal
  //            [9]Apps [10]GoCloud [11]GoLocal
  let totalEmailsSup     = 0;
  let totalPostsSup      = 0;
  let totalFichiersCloud = 0;
  let totalFichiersLocal = 0;
  let totalAppsSup       = 0;
  let totalGoCloud       = 0;
  let totalGoLocal       = 0;

  for (let i = 1; i < donData.length; i++) {
    if (!matchesFilter(donData[i], 1)) continue;

    // ⚠️ Vérification que ce ne sont pas des en-têtes
    if (typeof donData[i][5] === 'string' && isNaN(Number(donData[i][5]))) continue;

    totalEmailsSup     += Number(donData[i][5])  || 0;
    totalPostsSup      += Number(donData[i][6])  || 0;
    totalFichiersCloud += Number(donData[i][7])  || 0;
    totalFichiersLocal += Number(donData[i][8])  || 0;
    totalAppsSup       += Number(donData[i][9])  || 0;
    totalGoCloud       += Number(donData[i][10]) || 0;
    totalGoLocal       += Number(donData[i][11]) || 0;
  }

  const totalFichiersSup = totalFichiersCloud + totalFichiersLocal;
  const totalGo          = totalGoCloud + totalGoLocal;

  // ===== RÉEMPLOI =====
  let totalReemploi    = 0;
  let totalSmartphones = 0, totalPortables = 0;
  let totalFixes       = 0, totalEcrans    = 0, totalTablettes = 0;

  for (let i = 1; i < reData.length; i++) {
    if (!matchesFilter(reData[i], 1)) continue;
    const label = String(reData[i][5] || '');
    const total = (Number(reData[i][6]) || 0) + (Number(reData[i][7]) || 0)
                + (Number(reData[i][8]) || 0) + (Number(reData[i][9]) || 0);
    totalReemploi += total;
    if (label === 'Smartphone')          totalSmartphones += total;
    if (label === 'Ordinateur portable') totalPortables   += total;
    if (label === 'Ordinateur fixe')     totalFixes       += total;
    if (label === 'Écran')               totalEcrans      += total;
    if (label === 'Tablette')            totalTablettes   += total;
  }

  // ===== RECYCLAGE =====
  let totalPoidsKg    = 0;
  let poidsFixe       = 0, poidsPortable   = 0;
  let poidsEcran      = 0, poidsSmartphone = 0;

  for (let i = 1; i < recData.length; i++) {
    if (!matchesFilter(recData[i], 1)) continue;
    const label = String(recData[i][5] || '');
    const poids = Number(recData[i][7]) || 0;
    totalPoidsKg += poids;
    if (label === 'Ordinateur fixe')     poidsFixe       += poids;
    if (label === 'Ordinateur portable') poidsPortable   += poids;
    if (label === 'Écran')               poidsEcran      += poids;
    if (label === 'Smartphone')          poidsSmartphone += poids;
  }

  const totalPoidsTonnes  = totalPoidsKg / 1000;
  const matiereReutilisee = totalPoidsKg * 0.01;
  const matiereRecyclee   = totalPoidsKg * 0.76;
  const matiereValorisee  = totalPoidsKg * 0.12;
  const matiereDetruite   = totalPoidsKg * 0.11;

  return {
    totalDCD, typologies, regions,
    totalParticipants, totalAudience,
    totalEmailsSup, totalPostsSup,
    totalFichiersCloud, totalFichiersLocal, totalFichiersSup,
    totalAppsSup, totalGoCloud, totalGoLocal, totalGo,
    totalReemploi, totalSmartphones, totalPortables,
    totalFixes, totalEcrans, totalTablettes,
    totalPoidsKg, totalPoidsTonnes,
    matiereReutilisee, matiereRecyclee, matiereValorisee, matiereDetruite,
    poidsFixe, poidsPortable, poidsEcran, poidsSmartphone
  };
}

