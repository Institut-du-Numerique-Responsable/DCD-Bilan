function getDashboardData(e) {
  try {
    const ss              = SpreadsheetApp.openById(SPREADSHEET_ID);
    const filterRegion    = e.parameter.region    || '';
    const filterStructure = e.parameter.structure || '';

    const b   = lireDonneesBrutes(ss, filterRegion, filterStructure);
    const co2 = calculerCO2({
      goCloud:       b.totalGoCloud,
      goLocal:       b.totalGoLocal,
      emails:        b.totalEmailsSup,
      fichiersCloud: b.totalFichiersCloud,
      fichiersLocal: b.totalFichiersLocal,
      apps:          b.totalAppsSup,
      posts:         b.totalPostsSup,
      smartphones:   b.totalSmartphones,
      portables:     b.totalPortables,
      fixes:         b.totalFixes,
      ecrans:        b.totalEcrans,
      tablettes:     b.totalTablettes,
      poidsDeee:     b.totalPoidsKg
    });

    // ===== DEBUG =====
    console.log('=== getDashboardData ===');
    console.log('Emails :', b.totalEmailsSup);
