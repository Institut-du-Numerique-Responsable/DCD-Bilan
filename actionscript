/**
 * Convertit un onglet en tableau d'objets avec les clés fournies.
 * @param {Spreadsheet} ss
 * @param {string} sheetName - Nom de l'onglet
 * @param {string[]} keys - Noms des champs pour chaque colonne
 * @param {number[]} stringCols - Indices des colonnes à garder en string (dates, noms, types)
 */
function sheetToObjects(ss, sheetName, keys, stringCols) {
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return [];

  const data = sheet.getDataRange().getValues();
  if (data.length < 2) return [];

  const stringSet = new Set(stringCols || []);
  const rows = [];

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    // Ignorer lignes vides
    if (!row[0] && !row[1]) continue;

    var obj = {};
    for (var j = 0; j < keys.length && j < row.length; j++) {
      var val = row[j];
      // Formater les dates
      if (val instanceof Date) {
        val = Utilities.formatDate(val, Session.getScriptTimeZone(), 'yyyy-MM-dd');
      }
      // Convertir en nombre sauf colonnes string
      if (!stringSet.has(j) && typeof val === 'string' && val !== '') {
        var num = Number(String(val).replace(',', '.'));
        if (!isNaN(num)) val = num;
      }
      obj[keys[j]] = val === '' ? null : val;
    }
    // Calculer total pour réemploi
    if (keys.indexOf('reparation') !== -1) {
      obj.total = (Number(obj.don) || 0) + (Number(obj.reparation) || 0) +
                  (Number(obj.protection) || 0) + (Number(obj.reutilisation) || 0);
    }
    rows.push(obj);
  }
  return rows;
}

